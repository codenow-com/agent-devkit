#!/usr/bin/env bash
# cn-sandbox: run the local sandbox of the agent repository you are in (its own sandbox/sandbox.sh, so the
# sandbox always matches the agent's template version).
#
#   cn-sandbox up | run <pipeline> [subject] [json] | logs | events | status | down
#   cn-sandbox status           the agent's identity, Workforce onboarding and console URL (an ADK agent: the
#                               interpreter for the VS Code ADK extension), then sandbox.sh status
#   cn-sandbox token            write your own access token (oidc-agent) to the token file, once
#   cn-sandbox token --watch    the same every 45 s until stopped
#   cn-sandbox token --stop     stop the background refresh that `up` started, for every sandbox
#   cn-sandbox up               runs the agent as you (the developer identity) whenever it is ready: it writes the
#                               identity block into the agent's .env (also before the agent's first deployment: the
#                               console login is then the local dev identity provider). Not ready: one line says why
#                               and the deployment token is used.
#   cn-sandbox up --as-me       the same, and clears `as-me off` (stops when the identity is not ready)
#   cn-sandbox up --deployment-token   this run only on the deployment's token; the next `up` runs as you again
#   cn-sandbox as-me off|on|status     the deployment token from now on (remembered in .env) | as you again | show it
#   cn-sandbox forget [--yes] [--reason TEXT]   remove your development instance of this agent from Workforce
#   cn-sandbox hub [--stop|--status]  the page with every sandbox on this computer (http://localhost:8079/)
#
# With CN_IDENTITY_PROVIDER=developer (in the environment or the agent's .env) the agent runs under your own identity:
# `up` writes the token and starts `token --watch` in the background once for all sandboxes (the agent repositories
# that use it are listed next to the token), `down` stops it when no other sandbox uses it. Settings: CN_OIDC_ACCOUNT
# (the oidc-agent account, default cn-agw), CN_IDENTITY_TOKEN_FILE (default ~/.codenow/sandbox-token/token). Every
# other `token ...` (e.g. `token person <name>`) goes to the agent's sandbox.sh.
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do d="$(cd "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"; case "$src" in /*) ;; *) src="$d/$src" ;; esac; done
. "$(cd "$(dirname "$src")/.." && pwd)/lib/help.sh"
cn_help_first cn-sandbox "$@"
self="$(cd "$(dirname "$src")" && pwd)/$(basename "$src")"
lib="$(cd "$(dirname "$src")/.." && pwd)/lib"
. "$lib/common.sh"
. "$lib/sandbox_token.sh"
. "$lib/gateway_setup.sh"   # interactive, ask_yes
. "$lib/as_me.sh"
. "$lib/sandbox_hub.sh"
. "$lib/sandbox_forget.sh"
. "$lib/adk_tools.sh"       # adk_repo_hint
CN_CMD=cn-sandbox
note() { say "$*"; }

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
env_file=""
[ -z "$root" ] || env_file="$root/.env"

# developer_mode: CN_IDENTITY_PROVIDER=developer in the environment or in the agent's .env.
developer_mode() {
  local value="${CN_IDENTITY_PROVIDER:-}"
  if [ -z "$value" ] && [ -n "$env_file" ] && [ -f "$env_file" ]; then
    value="$(sed -n 's/^CN_IDENTITY_PROVIDER=//p' "$env_file" | tail -n 1 | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/")"
  fi
  [ "$value" = developer ]
}

if [ "${1:-}" = token ]; then
  case "${2:-}" in
    "")
      file="$(token_file_path "$env_file")"
      token_write "$file" || exit 1
      say "token of $(token_account) written to $file (valid at least ${TOKEN_SECONDS} s; keep it fresh with: cn-sandbox token --watch)"
      exit 0 ;;
    --watch) token_watch "$(token_file_path "$env_file")" ;;
    --stop) token_share_clear "$(token_file_path "$env_file")"; exit 0 ;;
  esac
fi

if [ "${1:-}" = hub ]; then
  case "${2:-}" in
    "") hub_start; exit $? ;;
    --stop) hub_stop; exit 0 ;;
    --status) hub_status; exit $? ;;
    *) cn_usage_error cn-sandbox "hub takes --stop or --status" ;;
  esac
fi

[ -n "$root" ] || { echo "cn-sandbox: not inside a git repository" >&2; exit 1; }
if [ "${1:-}" = forget ]; then
  shift
  yes=0; reason=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1 ;;
      --reason) [ "$#" -ge 2 ] || cn_usage_error cn-sandbox "--reason needs a text"; reason="$2"; shift ;;
      --reason=*) reason="${1#--reason=}" ;;
      *) cn_usage_error cn-sandbox "forget takes --yes and --reason TEXT" ;;
    esac
    shift
  done
  load_config
  forget_run "$root" "$env_file" "$yes" "$reason"
  exit 0
fi
if [ "${1:-}" = as-me ]; then
  load_config
  case "${2:-}" in
    off)
      case "${3:-}" in ""|--forget) ;; *) cn_usage_error cn-sandbox "as-me off takes only --forget" ;; esac
      forget_from="$(forget_url "$env_file")"   # before the block (and its WORKFORCE_URL) goes
      asme_off "$env_file"
      asme_mark_off "$env_file"
      say "from now on cn-sandbox up uses the deployment token in this repository (cn-sandbox as-me on: as you again)"
      token_share_stop "$(token_file_path "$env_file")" "$root"
      # Also offer to remove the development instance from Workforce: --forget, or a yes on a terminal.
      if [ -n "$forget_from" ] && { [ "${3:-}" = --forget ] \
          || ask_yes "Also remove your development instance from Workforce?"; }; then
        ( CODENOW_WORKFORCE_URL="$forget_from" forget_run "$root" "$env_file" 1 "" ) \
          || say "the development instance stays in Workforce (cn-sandbox forget tries again)"
      fi
      exit 0 ;;
    on)
      asme_mark_on "$env_file"
      asme_on "$root" "$env_file"
      say "cn-sandbox up runs the agent as you again"
      exit 0 ;;
    status) asme_status "$env_file"; exit 0 ;;
    *) cn_usage_error cn-sandbox "as-me needs off, on or status" ;;
  esac
fi
[ -f "$root/sandbox/sandbox.sh" ] || { echo "cn-sandbox: $root has no sandbox/sandbox.sh (an agent from the CodeNOW Agent SDK template 1.1.0 or newer has one)" >&2; exit 1; }
cd "$root"
case "${1:-}" in
  up)
    args=()
    choice=default
    for arg in "$@"; do
      case "$arg" in
        --as-me) choice=as-me ;;
        --deployment-token) choice=deployment ;;
        *) args+=("$arg") ;;
      esac
    done
    set -- "${args[@]}"
    load_config
    asme_choose "$root" "$env_file" "$choice"   # the identity of this run (as_me.sh); writes sandbox/.run/identity-mode
    if developer_mode; then
      file="$(token_file_path "$env_file")"
      [ -n "$ASME_TOKEN_WRITTEN" ] || token_write "$file" \
        || die "no token: the sandbox under your own identity needs oidc-token $(token_account)"
      export CN_IDENTITY_TOKEN_FILE="$file"   # the sandbox copies the token from here
      asme_predeploy_env   # before the first deployment the sandbox takes the gateway from these
      token_share_start "$file" "$root" "$(asme_project "$root")" "$self"
    fi
    rc=0; bash sandbox/sandbox.sh "$@" || rc=$?
    if [ "$rc" != 0 ] && developer_mode; then token_share_stop "$(token_file_path "$env_file")" "$root"; fi
    [ "$rc" != 0 ] || { say "console: $(asme_console "$root") (log in on localhost, not on 127.0.0.1)"; hub_for_up; }
    exit "$rc" ;;
  status)
    load_config
    asme_identity "$root" "$env_file"
    adk_repo_hint "$root"   # an ADK agent: the interpreter for the VS Code ADK extension, the ports
    file="$(token_file_path "$env_file")"
    if developer_mode || watch_alive "$file" >/dev/null; then token_share_status "$file"; fi
    exec bash sandbox/sandbox.sh "$@" ;;
  down)
    rc=0; bash sandbox/sandbox.sh "$@" || rc=$?
    token_share_stop "$(token_file_path "$env_file")" "$root"
    exit "$rc" ;;
  *) exec bash sandbox/sandbox.sh "$@" ;;
esac
