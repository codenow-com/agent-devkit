#!/usr/bin/env bash
# cn-doctor: report what this computer has and lacks for developing CodeNOW agents. Changes nothing.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do d="$(cd "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"; case "$src" in /*) ;; *) src="$d/$src" ;; esac; done
exec bash "$(cd "$(dirname "$src")" && pwd)/cn-setup" --check
