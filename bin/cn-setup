#!/usr/bin/env bash
# cn-setup: prepare this computer for developing CodeNOW agents.
#
#   cn-setup           set up what is missing; asks once for the MCP URL of your tenant and the kubeconfig
#   cn-setup --check   only report (the same as cn-doctor)
#
# It checks the tools, adds the CodeNOW MCP server to Claude Code, Codex and GitHub Copilot CLI, installs the
# devkit skills into them, and checks the kubeconfig. Settings: ~/.codenow/config. It never stores a token.
# Environment: CODENOW_MCP_URL, KUBECONFIG_FILE, CODENOW_MCP_NAME (default codenow), CODENOW_API_KEY (Copilot only).
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do d="$(cd "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"; case "$src" in /*) ;; *) src="$d/$src" ;; esac; done
. "$(cd "$(dirname "$src")/.." && pwd)/lib/common.sh"
CN_CMD=cn-setup
check=0
[ "${1:-}" = "--check" ] && check=1 && CN_CMD=cn-doctor
load_config
problems=0
note() { say "$*"; problems=$((problems + 1)); }

# 1. Tools
for tool in git curl python3; do have "$tool" || die "install $tool first:  $(install_hint "$tool")"; done

# The devkit itself: its version against the newest release, local changes, the cn-* links and the PATH.
if git -C "$DEVKIT_DIR" rev-parse --git-dir >/dev/null 2>&1; then
  current="$(git -C "$DEVKIT_DIR" describe --tags --exact-match 2>/dev/null || true)"
  newest="$(git -C "$DEVKIT_DIR" ls-remote --tags --refs origin 'v*' 2>/dev/null | sed 's#.*refs/tags/##' \
    | sort -V | tail -n 1 || true)"
  if [ -z "$current" ]; then note "devkit: not on a release tag ($(git -C "$DEVKIT_DIR" rev-parse --short HEAD)): run cn-update"
  elif [ -z "$newest" ]; then say "devkit $current (cannot reach $(git -C "$DEVKIT_DIR" remote get-url origin) to compare)"
  elif [ "$current" != "$newest" ] && [ "$(printf '%s\n%s\n' "$current" "$newest" | sort -V | tail -n 1)" = "$newest" ]; then
    note "devkit $current is old; $newest is out: run cn-update"
  else say "devkit $current (newest)"; fi
  [ -z "$(git -C "$DEVKIT_DIR" status --porcelain 2>/dev/null)" ] \
    || note "devkit: files in $DEVKIT_DIR were changed; cn-update keeps them only until the next release (git -C $DEVKIT_DIR status)"
fi
for cmd in "$DEVKIT_DIR"/bin/cn-*; do
  found="$(command -v "$(basename "$cmd")" 2>/dev/null || true)"
  if [ -z "$found" ]; then note "$(basename "$cmd") is not in PATH: run the devkit install.sh again, then open a new terminal"
  elif [ "$(cd "$(dirname "$found")" && cd "$(dirname "$(readlink "$found" || echo "$found")")" && pwd)" != "$DEVKIT_DIR/bin" ]; then
    note "$(basename "$cmd") in PATH is $found, not this devkit's: remove it or put ~/.local/bin first in PATH"
  fi
done
[ ! -f "$CODENOW_CONFIG" ] || [ "$(ls -l "$CODENOW_CONFIG" | cut -c5-10)" = "------" ] \
  || note "$CODENOW_CONFIG is readable by other users: chmod 600 $CODENOW_CONFIG"
if have docker && docker compose version >/dev/null 2>&1; then
  if docker info >/dev/null 2>&1; then say "Docker with Compose: ok"
  else note "Docker is installed but this user cannot use it (not running, or not in the docker group: log in again)"; fi
else
  note "Docker with Compose v2 is missing (needed for the sandbox):  $(install_hint docker)"
fi
# kubectl reads the agent's Secret for .env; the CodeNOW kubeconfig logs in through the pinniped CLI.
for tool in kubectl pinniped; do
  if have "$tool"; then say "found $tool"; else note "$tool is missing (needed for .env):  $(install_hint "$tool")"; fi
done
# OpenSpec: every change of an agent goes through it (AGENTS.md of the agent template); the template's files need 1.17+.
openspec_min=1.17.0
if have openspec; then
  openspec_v="$(openspec --version 2>/dev/null | tr -d '[:space:]')"
  if [ "$(printf '%s\n%s\n' "$openspec_min" "$openspec_v" | sort -V | head -n 1)" = "$openspec_min" ]; then
    say "found openspec $openspec_v"
  else note "openspec $openspec_v is older than $openspec_min:  $(install_hint openspec)"; fi
elif have npm; then note "openspec is missing (every agent change goes through OpenSpec):  $(install_hint openspec)"
else note "openspec is missing and needs Node.js:  $(install_hint node), then  $(install_hint openspec)"; fi
have conda && say "found conda" || say "not found: conda (optional; a .venv works too)"
for tool in claude codex copilot; do
  if have "$tool"; then say "found $tool"; else say "not found: $tool (optional):  $(install_hint "$tool")"; fi
done
have claude || have codex || have copilot || note "no coding assistant found: install Claude Code, Codex or GitHub Copilot CLI"

# 2. Settings
[ "$check" = 1 ] || ask_setting CODENOW_MCP_URL "CodeNOW MCP URL of your tenant (https://mcp-server-<tenant>.<domain>/mcp):"
[ "$check" = 1 ] || ask_setting KUBECONFIG_FILE "path of the kubeconfig from the CodeNOW UI (Clusters > Cluster Access), empty to skip:"
[ -n "${CODENOW_MCP_URL:-}" ] || note "no CodeNOW MCP URL set: run cn-setup"
name="${CODENOW_MCP_NAME:-codenow}"

# 3. CodeNOW MCP server in each assistant (user scope, so every repository sees it). Presence is read from the
# assistants' own config files: their "mcp list" commands connect to the server and can hang without a login.
has_url() { [ -f "$1" ] && grep -qF "$CODENOW_MCP_URL" "$1"; }
if [ -n "${CODENOW_MCP_URL:-}" ]; then
  if have claude; then
    if has_url "$HOME/.claude.json"; then say "Claude Code: CodeNOW MCP ok"
    elif [ "$check" = 1 ]; then note "Claude Code: CodeNOW MCP missing"
    elif claude mcp add --transport http --scope user "$name" "$CODENOW_MCP_URL" >/dev/null 2>&1; then
      say "Claude Code: added MCP server $name; it asks for the CodeNOW login on first use"
    else note "Claude Code: adding the MCP server failed; try: claude mcp add --transport http --scope user $name $CODENOW_MCP_URL"; fi
  fi
  # Codex and Copilot CLI cannot use the CodeNOW login (the tenant refuses their dynamic client registration), so
  # they send an API key header. Codex reads the key from the CODENOW_API_KEY variable at start; the file keeps no key.
  if have codex; then
    codex_conf="$HOME/.codex/config.toml"
    if has_url "$codex_conf"; then say "Codex: CodeNOW MCP ok"
    elif [ "$check" = 1 ]; then note "Codex: CodeNOW MCP missing"
    else
      mkdir -p "$HOME/.codex"
      printf '\n[mcp_servers.%s]\nurl = "%s"\nenv_http_headers = { "X-Codenow-Api-Key" = "CODENOW_API_KEY" }\n' \
        "$name" "$CODENOW_MCP_URL" >> "$codex_conf"
      say "Codex: added MCP server $name; it sends the API key from CODENOW_API_KEY (export it in your shell)"
    fi
  fi
  if have copilot; then
    if has_url "$HOME/.copilot/mcp-config.json"; then say "Copilot CLI: CodeNOW MCP ok"
    elif [ "$check" = 1 ]; then note "Copilot CLI: CodeNOW MCP missing"
    elif [ -n "${CODENOW_API_KEY:-}" ]; then
      if copilot mcp add --transport http --header "X-Codenow-Api-Key: $CODENOW_API_KEY" "$name" "$CODENOW_MCP_URL" >/dev/null 2>&1; then
        say "Copilot CLI: added MCP server $name (Copilot keeps the API key in ~/.copilot/mcp-config.json)"
      else note "Copilot CLI: adding the MCP server failed"; fi
    else
      say "Copilot CLI: run  CODENOW_API_KEY=<key> cn-setup  to add the server with an API key"
      say "  (CodeNOW UI: your profile > API keys)"
    fi
  fi
  # VS Code Copilot Chat reads the user-level mcp.json. The file keeps no key: VS Code asks for it once
  # (${input:...}) and keeps it in its own secret storage. Other servers in the file stay as they are.
  mode=apply; [ "$check" = 1 ] && mode=check
  vscode_out="$(python3 -I "$DEVKIT_DIR/lib/vscode_mcp.py" "$mode" "$name" "$CODENOW_MCP_URL" 2>&1)" || vscode_rc=$?
  while IFS= read -r line; do [ -n "$line" ] && echo "${CN_CMD:-cn}: $line"; done <<< "$vscode_out"
  [ "${vscode_rc:-0}" = 0 ] || problems=$((problems + 1))
fi

# 4. Devkit skills for each assistant (copied, refreshed by cn-update)
for target in "$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.copilot/skills"; do
  case "$target" in
    */.claude/*) have claude || continue ;;
    */.codex/*) have codex || continue ;;
    */.copilot/*) have copilot || have code || continue ;;  # VS Code Copilot Chat reads ~/.copilot/skills too
  esac
  for skill in "$DEVKIT_DIR"/skills/*/; do
    skill_name="$(basename "$skill")"
    if [ "$check" = 1 ]; then
      if [ ! -f "$target/$skill_name/SKILL.md" ]; then note "skill $skill_name missing in $target: run cn-setup"
      elif ! diff -rq "$skill" "$target/$skill_name" >/dev/null 2>&1; then
        note "skill $skill_name in $target differs from the devkit's: run cn-setup"
      fi
    else
      mkdir -p "$target"; rm -rf "${target:?}/$skill_name"; cp -R "$skill" "$target/$skill_name"
    fi
  done
done
[ "$check" = 1 ] || say "skills installed: $(cd "$DEVKIT_DIR/skills" && ls | tr '\n' ' ')"

# 5. kubeconfig
if [ -n "${KUBECONFIG_FILE:-}" ]; then
  kc="${KUBECONFIG_FILE/#\~/$HOME}"
  if [ ! -f "$kc" ]; then note "kubeconfig not found: $kc"
  elif ! have kubectl; then note "kubectl is missing (needed to read the agent's Secret)"
  else
    say "kubeconfig: checking the cluster; a browser may open for the CodeNOW login of the cluster (pinniped)"
    rc=0; run_limited 20 env KUBECONFIG="$kc" kubectl version --request-timeout=15s || rc=$?
    if [ "$rc" = 0 ]; then say "kubeconfig: ok"
    elif [ "$rc" = 124 ]; then note "kubeconfig: no answer in 20 s; the cluster login probably waits in the browser: run  KUBECONFIG=$kc kubectl get ns"
    else note "kubeconfig: kubectl cannot reach the cluster"; fi
  fi
fi

# 6. The CodeNOW Agent SDK (sdlc-agent-kernel) is not on public PyPI: pip must find it through the developer's
# pip.conf (the tenant's PyPI index), or the agent repository needs the wheel in sandbox/wheels/.
if ! python3 -m pip --version >/dev/null 2>&1; then
  note "pip is missing:  $(install_hint pip)"
else
  tmp="$(mktemp -d)"; rc=0
  run_limited 60 python3 -m pip download --no-deps --quiet --disable-pip-version-check -d "$tmp" sdlc-agent-kernel \
    >/dev/null 2>&1 || rc=$?
  rm -rf "$tmp"
  if [ "$rc" = 0 ]; then say "CodeNOW Agent SDK: pip finds sdlc-agent-kernel"
  else
    note "CodeNOW Agent SDK: pip does not find sdlc-agent-kernel (the tenant's PyPI index is missing or not readable)"
    say "  1. the index URL: CodeNOW UI > Libraries > sdlc-agent-kernel > Setup Instructions"
    say "     (usually https://codenow.jfrog.io/artifactory/api/pypi/<tenant>-pip/simple)"
    say "  2. a token: CodeNOW UI > gear icon > Profile > Keys & Tokens > Artifact Repository Tokens > Generate token"
    say "     (a token without Read on the index gets 403, and pip says only 'from versions: none')"
    say "  3. add  https://<CodeNOW user>:<token>@<index host and path>  under extra-index-url in your pip.conf, keep"
    say "     https://pypi.org/simple there too, and  chmod 600  the file"
  fi
fi
# A pip.conf that holds credentials must not be readable by other users.
for f in "$HOME/.pip/pip.conf" "$HOME/.config/pip/pip.conf" "$HOME/Library/Application Support/pip/pip.conf"; do
  [ -f "$f" ] && grep -q '://[^/@ ]*@' "$f" 2>/dev/null || continue
  case "$(ls -l "$f" | cut -c5-10)" in
    ------) ;;
    *) note "pip.conf with credentials is readable by other users: chmod 600 \"$f\"" ;;
  esac
done

echo
if [ "$check" = 1 ]; then
  [ "$problems" = 0 ] && say "all good" || { say "$problems problem(s); run cn-setup"; exit 1; }
else
  say "done. Next: cn-new-agent (creates an agent with your coding assistant)"
fi
